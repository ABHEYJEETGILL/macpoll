generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  role         UserRole
  createdAt    DateTime  @default(now())
  verifiedAt   DateTime?

  enrollments  Enrollment[]
  courses      Course[]      @relation("CourseOwner")
  liveSessions LiveSession[] @relation("LiveSessionCreator")
  responses     Response[]
  attendances   Attendance[]
  auditLogs     AuditLog[]
  participation PollParticipation[]
}

enum UserRole {
  INSTRUCTOR
  STUDENT
}

model Course {
  id                String  @id @default(cuid())
  name              String
  term              String
  ownerInstructor   User    @relation("CourseOwner", fields: [ownerInstructorId], references: [id], onDelete: Cascade)
  ownerInstructorId String
  joinCode          String  @unique

  enrollments  Enrollment[]
  liveSessions LiveSession[]

  createdAt DateTime @default(now())

  @@index([ownerInstructorId])
}

model Enrollment {
  id           String @id @default(cuid())
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  roleInCourse String

  createdAt DateTime @default(now())

  @@unique([courseId, userId])
  @@index([userId])
}

model LiveSession {
  id          String    @id @default(cuid())
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  createdBy   User      @relation("LiveSessionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  sessionCode String    @unique

  polls       Poll[]
  attendances Attendance[]

  @@index([courseId, startedAt])
}

model Poll {
  id            String      @id @default(cuid())
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  liveSessionId String
  type          PollType
  questionText  String
  optionsJson   Json?
  isAnonymous   Boolean     @default(false)
  allowChange   Boolean     @default(true)
  timeLimitSec  Int?
  createdAt     DateTime    @default(now())
  openedAt      DateTime?
  closedAt      DateTime?

  responses     Response[]
  participation PollParticipation[]

  @@index([liveSessionId, createdAt])
}

enum PollType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  NUMERIC
}

model Response {
  id          String   @id @default(cuid())
  poll        Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId      String
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  submittedAt DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  answerJson  Json

  // One response per student per poll. Postgres treats NULLs as distinct, so
  // anonymous polls (userId = null) can still hold many rows.
  @@unique([pollId, userId])
  @@index([pollId])
}

/// Records that a user answered a poll, without linking them to their answer.
/// Anonymous polls store no userId on Response, so this is what stops one
/// student submitting an anonymous poll repeatedly.
model PollParticipation {
  id        String   @id @default(cuid())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([pollId, userId])
  @@index([userId])
}

model Attendance {
  id            String      @id @default(cuid())
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  liveSessionId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  presentBool   Boolean     @default(false)
  firstJoinAt   DateTime    @default(now())

  @@unique([liveSessionId, userId])
  @@index([userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  instructor   User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  instructorId String
  action       String
  createdAt    DateTime @default(now())
  metadata     Json?

  @@index([instructorId, createdAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
  @@index([email])
}
