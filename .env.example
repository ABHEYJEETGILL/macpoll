# --- Database -------------------------------------------------------------
# Any PostgreSQL instance. `docker compose up -d db` provisions the one below.
DATABASE_URL="postgresql://macpoll:macpoll@localhost:5432/macpoll?schema=public"

# --- Secrets --------------------------------------------------------------
# Generate each with: openssl rand -hex 32
# SESSION_SECRET signs session cookies. Rotating it logs everybody out.
SESSION_SECRET="replace-me-with-at-least-32-random-characters"
# Shared between the Next.js app and the realtime server so that only the app
# can publish poll events. Must be identical in both processes.
REALTIME_INTERNAL_SECRET="replace-me-with-at-least-32-random-characters"

# --- Realtime -------------------------------------------------------------
# Public URL the browser uses to reach the Socket.io server.
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"
# URL the Next.js server uses to publish events (usually the same host).
REALTIME_INTERNAL_URL="http://localhost:4000"
REALTIME_PORT="4000"
# Comma-separated origins allowed to open a websocket.
REALTIME_ALLOWED_ORIGINS="http://localhost:3000"

# --- Demo seed data -------------------------------------------------------
DEMO_INSTRUCTOR_EMAIL="demo.instructor@mcmaster.ca"
DEMO_STUDENT_EMAIL="demo.student@mcmaster.ca"
# Password for every seeded demo account. Seeding refuses to run in production.
DEMO_PASSWORD="password123"
